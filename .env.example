# Optional. All defaults work with no config at all.
# PORT is set by Railway automatically.
PORT=3000
# DEMO_MODE=1 serves the bundled sample report for every scan (no network).
# Leave unset (or 0) for real on-chain scans.
DEMO_MODE=0
# RPC_URL overrides the default public endpoints
# (https://ethereum.publicnode.com, then https://eth.drpc.org).
# No API key is needed for the defaults.
# RPC_URL=https://ethereum.publicnode.com
